<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Herculan.Engine.Host</RootNamespace>
    <AssemblyName>Herculan.Engine.Host</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Herculan.Engine\Herculan.Engine.csproj" />
  </ItemGroup>

  <!-- The debug panel only. Nothing the game itself draws goes through ImGui — the cockpit and its
       HUD are the original's own art and its own font (see Overlay2DRenderer, HudFont). -->
  <ItemGroup>
    <PackageReference Include="Silk.NET.OpenGL.Extensions.ImGui" Version="2.23.0" />
  </ItemGroup>

  <!-- Linked from the editor host rather than copied: one font file, two hosts. -->
  <ItemGroup>
    <None Include="..\Herculan.Engine.Host.Editor\Assets\Fonts\Open_Sans\static\OpenSans-Regular.ttf"
          Link="Assets\Fonts\Open_Sans\static\OpenSans-Regular.ttf"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
